GRAPH_AUTH_MODE=entra
DATABASE_URL=postgresql://dispatcher:replace-me@127.0.0.1:55432/dispatcher_dev
ENTRA_TENANT_ID=00000000-0000-4000-8000-000000000001
ENTRA_CLIENT_ID=00000000-0000-4000-8000-000000000002
ENTRA_CLIENT_SECRET=replace-with-development-application-secret
GRAPH_MAILBOX_ID=00000000-0000-4000-8000-000000000003
API_TOKEN=replace-with-at-least-32-random-characters
PORT=3100

# Used only when GRAPH_AUTH_MODE=graph-scrap; no app registration fields required.
GRAPH_SCRAP_URL=http://127.0.0.1:3101
GRAPH_SCRAP_API_KEY=replace-with-a-separate-32-character-service-key
