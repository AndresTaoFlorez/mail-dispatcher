{
  "name": "mail-dispatcher",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "backend/mail-api",
    "backend/graph-scrap",
    "database"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:postgres": "node --env-file=database/.env database/scripts/test-postgres.js",
    "lint": "eslint backend database/scripts",
    "format": "prettier --write backend database package.json tsconfig.base.json eslint.config.js",
    "format:check": "prettier --check backend database package.json tsconfig.base.json eslint.config.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev:mail-api": "npm run dev -w @mail-dispatcher/mail-api",
    "dev:graph-scrap": "npm run dev -w @mail-dispatcher/graph-scrap"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.12.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
