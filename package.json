{
  "name": "mail-dispatcher",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend",
    "database"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:postgres": "node --env-file=database/.env database/scripts/test-postgres.js",
    "lint": "eslint backend/src backend/tests frontend/src database/scripts",
    "format": "prettier --write backend frontend database package.json tsconfig.base.json eslint.config.js",
    "format:check": "prettier --check backend frontend database package.json tsconfig.base.json eslint.config.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.12.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
